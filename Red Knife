            TweenService:Create(SliderFill, TweenInfo.new(0.08), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
            local val = math.floor(minVal + (pos * (maxVal - minVal)))
            ValueLabel.Text = tostring(val)
            if callback then callback(val) end
        end
    end)
end

