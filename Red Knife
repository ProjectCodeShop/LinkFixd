local function IsInSafeZone(player)
    if not player or not player.Character then return true end
    local char = player.Character
    
    -- เช็ค ForceField
    if char:FindFirstChildOfClass("ForceField") then return true end
    
    -- เช็คโฟลเดอร์ SafeZone หรือ NonPVP (ถ้าเกมมี)
    if char:FindFirstChild("SafeZone") or char:FindFirstChild("NonPVP") or char:FindFirstChild("Protected") then
        return true
    end
    
    return false
end

local function CacheCharacterParts(player, character)
    if not player or not character then return end
    PlayerCache[player] = {}
    
    local rootPart = character:WaitForChild("HumanoidRootPart", 3)
    if not rootPart then return end

    for _, name in ipairs(targetPartsList) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            table.insert(PlayerCache[player], part)
        end
    end
end

local function RegisterPlayer(player)
    if player.Character then 
        task.spawn(function() CacheCharacterParts(player, player.Character) end)
    end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.3)
        CacheCharacterParts(player, char)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do RegisterPlayer(p) end
Players.PlayerAdded:Connect(RegisterPlayer)
Players.PlayerRemoving:Connect(function(p) PlayerCache[p] = nil end)

local auraQueueActive = false
local allMapSpamActive = false
local selfSpamActive = false
local autoEquipSpamActive = false
local auraDistanceThreshold = 100

-- ฟังก์ชันส่งรีโมทโจมตี
local function DirectFireCombo(targetPart)
    if not targetPart or not targetPart.Parent then return end
    pcall(function()
        local myChar = LocalPlayer.Character
        if myChar then
            local punchFolder = myChar:FindFirstChild("หมัด")
            if punchFolder and punchFolder:FindFirstChild("Combo") then
                local combo = punchFolder.Combo
                if combo:FindFirstChild("C1") then combo.C1:FireServer(table.unpack({[1] = targetPart, n = 1}, 1, 1)) end
            end
        end
    end)
end

task.spawn(function()
    while true do
        if autoEquipSpamActive then
            pcall(function()
                local myChar = LocalPlayer.Character
                local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                if myChar and backpack then
                    local humanoid = myChar:FindFirstChildOfClass("Humanoid")
                    local tools = backpack:GetChildren()
                    if humanoid and #tools > 0 then
                        for _, tool in ipairs(tools) do
                            if tool:IsA("Tool") and autoEquipSpamActive then
                                humanoid:UnequipTools()
                                task.wait(0.015)
                                humanoid:EquipTool(tool)
                                task.wait(0.02)
                                humanoid:UnequipTools()
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

-- ลูปหลักโจมตีแบบข้าม SafeZone / ข้ามตัวที่ตีไม่เข้าทันที
task.spawn(function()
    while true do
        if auraQueueActive then
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local validTargets = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local isIgnored = (ignoreSelections[p.Name] == true)
                        
                        local hasTargetList = false
                        for name, state in pairs(targetSelections) do
                            if state then hasTargetList = true break end
                        end

                        local isTargetAllowed = true
                        if hasTargetList then
                            isTargetAllowed = (targetSelections[p.Name] == true)
                        end

                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        local targetRoot = p.Character:FindFirstChild("HumanoidRootPart")

                        -- ตรวจสอบว่าไม่อยู่ใน SafeZone และมีชีวิตอยู่
                        if not isIgnored and isTargetAllowed and hum and hum.Health > 0 and targetRoot and not IsInSafeZone(p) then
                            local dist = (targetRoot.Position - myRoot.Position).Magnitude
                            if dist <= auraDistanceThreshold then
                                table.insert(validTargets, p)
                            end
                        end
                    end
                end

                if #validTargets > 0 then
                    for _, targetPlayer in ipairs(validTargets) do
                        if not PlayerCache[targetPlayer] or #PlayerCache[targetPlayer] == 0 then
                            CacheCharacterParts(targetPlayer, targetPlayer.Character)
                        end
                        
                        if PlayerCache[targetPlayer] and #PlayerCache[targetPlayer] > 0 then
                            for _, part in ipairs(PlayerCache[targetPlayer]) do
                                if part and part.Parent then
                                    DirectFireCombo(part)
                                end
                            end
                        end
                    end
                end
            end
        end

        if allMapSpamActive then
            for player, parts in pairs(PlayerCache) do
                if player ~= LocalPlayer and player.Parent and player.Character then
                    if not ignoreSelections[player.Name] then
                        local hum = player.Character:FindFirstChildOfClass("Humanoid")
                        -- ข้ามทันทีถ้าตัวละครเข้า SafeZone หรือไม่มีเลือด
                        if hum and hum.Health > 0 and not IsInSafeZone(player) then
                            if not parts or #parts == 0 then
                                CacheCharacterParts(player, player.Character)
                                parts = PlayerCache[player]
                            end

                            if parts and #parts > 0 then
                                for _, part in ipairs(parts) do
                                    if part and part.Parent then
                                        DirectFireCombo(part)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        if selfSpamActive then
            local myChar = LocalPlayer.Character
            if myChar then
                for _, name in ipairs(targetPartsList) do
                    local part = myChar:FindFirstChild(name)
                    if part and part:IsA("BasePart") then
                        DirectFireCombo(part)
                    end
                end
            end
        end

        task.wait(0.04)
    end
end)

