local currentIDsText = ""

-- ฟังก์ชันดึง ID จาก HumanoidDescription (แม่นยำที่สุด)
local function fetchAccurateIDs()
	local character = player.Character
	if not character then return "ไม่พบตัวละคร" end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return "ไม่พบ Humanoid ของตัวละคร" end
	
	local success, description = pcall(function()
		return humanoid:GetAppliedDescription()
	end)
	
	if not success or not description then
		return "ไม่สามารถดึงข้อมูลตัวละครนี้ได้"
	end
	
	local foundIDs = {}
	
	-- ดึงเสื้อและกางเกงแบบทางการ
	if description.Shirt > 0 then
		table.insert(foundIDs, "Shirt ID: " .. tostring(description.Shirt))
	end
	if description.Pants > 0 then
		table.insert(foundIDs, "Pants ID: " .. tostring(description.Pants))
	end
	if description.GraphicTShirt > 0 then
		table.insert(foundIDs, "Graphic T-Shirt ID: " .. tostring(description.GraphicTShirt))
	end
	
	-- ดึงไอเทม/เครื่องประดับทั้งหมดที่สวมใส่
	local successAcc, accessories = pcall(function()
		return description:GetAccessories(true)
	end)
	
	if successAcc and accessories then
		for _, acc in ipairs(accessories) do
			if acc.AssetId then
				table.insert(foundIDs, "Accessory/Item ID: " .. tostring(acc.AssetId))
			end
		end
	end
	
	if #foundIDs > 0 then
		return table.concat(foundIDs, "\n")
	else
		return "ไม่พบรหัสไอเทมที่เป็นทางการในตัวละครนี้"
	end
end

