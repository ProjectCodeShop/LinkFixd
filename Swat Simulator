task.spawn(function()
    while alive() do
        if M.Kill then
            local ev = getACSEvents()
            local tool = ev and getTool() or nil
            if tool then
                local okS, settings = pcall(require, tool:FindFirstChild("ACS_Settings"))
                if okS then
                    local token = getToken(ev)
                    for _, t in ipairs(collectTargets()) do
                        if not M.Kill or not alive() then break end
                        if t.hum.Health > 0 and (not M.ArmedOnly or isArmed(t.model)) then
                            pcall(function()
                                ev.Damage:InvokeServer(tool, t.hum, t.dist, 1, settings, MODS, nil, nil, token)
                                ev.HitEffect:FireServer(t.head.Position, t.head, Vector3.new(0, 1, 0), t.head.Material, settings)
                            end)
                            task.wait(M.PerShot)
                        end
                    end
                    task.wait(M.LoopDelay)
                else task.wait(1) end
            else task.wait(1) end
        else task.wait(0.2) end
    end
end)

local marks = {}
task.spawn(function()
    while alive() do
        local seen = {}
        if M.ESP then
            for _, m in ipairs(CollectionService:GetTagged("NPC")) do
                if m:IsA("Model") and m ~= LocalPlayer.Character then
                    local hum = m:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        seen[m] = true
                        local h = marks[m]
                        if not h or h.Parent == nil then
                            h = Instance.new("Highlight")
                            h.Adornee = m
                            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            h.FillTransparency = 0.5
                            h.Parent = m
                            marks[m] = h
                        end
                        local col = isArmed(m) and Color3.fromRGB(255, 59, 48) or Color3.fromRGB(52, 199, 89)
                        h.FillColor = col
                        h.OutlineColor = col
                        h.Enabled = true
                    end
                end
            end
        end
        for model, h in pairs(marks) do
            if not seen[model] or not M.ESP then
                pcall(function() h:Destroy() end)
                marks[model] = nil
            end
        end
        task.wait(1)
    end
    for _, h in pairs(marks) do pcall(function() h:Destroy() end) end
end)

