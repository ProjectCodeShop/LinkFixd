    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.H then
            M.Kill = not M.Kill
            pcall(function() killT.Set(M.Kill) end)
        elseif input.KeyCode == Enum.KeyCode.N then
            M.ESP = not M.ESP
            pcall(function() espT.Set(M.ESP) end)
        end
    end)
end

local function ToggleHub()
    isOpen = not isOpen
    UpdateBlurState()
    if isOpen then
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, SidebarWidth, 0, 330)
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, FullWidth, 0, 330)}):Play()
    else
        Camera.FieldOfView = OriginalFOV
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 0, 0, 330)})
        tween:Play()
        tween.Completed:Connect(function()
            if not isOpen then MainFrame.Visible = false end
        end)
    end
end

local FloatBtn = Instance.new("ImageButton")
FloatBtn.Name = "iOSFloatButton"
FloatBtn.Size = UDim2.new(0, 52, 0, 52)
FloatBtn.Position = UDim2.new(0, 12, 0.5, -26)
FloatBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
FloatBtn.BackgroundTransparency = 0.2
FloatBtn.Image = "rbxassetid://103143683174616"
FloatBtn.ScaleType = Enum.ScaleType.Crop
FloatBtn.Active = true
FloatBtn.Parent = ScreenGui

Instance.new("UICorner", FloatBtn).CornerRadius = UDim.new(1, 0)
local FloatStroke = Instance.new("UIStroke", FloatBtn)
FloatStroke.Color = Color3.fromRGB(255, 255, 255)
FloatStroke.Thickness = 1.5
FloatStroke.Transparency = 0.5

local floatDragging = false
local floatDragInput, floatDragStart, floatStartPos
local floatMoved = false

FloatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        floatDragging = true
        floatMoved = false
        floatDragStart = input.Position
        floatStartPos = FloatBtn.Position
        floatDragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if floatDragging and (input == floatDragInput or input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - floatDragStart
        if delta.Magnitude > 6 then 
            floatMoved = true 
            FloatBtn.Position = UDim2.new(
                floatStartPos.X.Scale, floatStartPos.X.Offset + delta.X,
                floatStartPos.Y.Scale, floatStartPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == floatDragInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        floatDragging = false
    end
end)

FloatBtn.MouseButton1Click:Connect(function()
    if not floatMoved then ToggleHub() end
end)
