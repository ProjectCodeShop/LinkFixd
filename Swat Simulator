local function getTool()
    local char = LocalPlayer.Character
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("ACS_Settings") then return t end
        end
    end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp and char then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("ACS_Settings") then
                pcall(function() t.Parent = char end)
                task.wait(0.2)
                return t
            end
        end
    end
    return nil
end

local function getToken(ev)
    local ok, id = pcall(function() return ev.AcessId:InvokeServer(LocalPlayer.UserId) end)
    if not ok or id == nil then return tostring(LocalPlayer.UserId) end
    if type(id) == "table" then id = id[1] or id.Id or tostring(id) end
    return tostring(id) .. "-" .. tostring(LocalPlayer.UserId)
end

local function isArmed(model)
    for _, c in ipairs(model:GetDescendants()) do
        if c:IsA("Tool") then return true end
    end
    return false
end

local function myPos()
    local c = LocalPlayer.Character
    if not c then return nil end
    local ok, p = pcall(function() return c:GetPivot().Position end)
    return ok and p or nil
end

local function collectTargets()
    local out = {}
    local mp = myPos()
    if not mp then return out end
    local function push(model, hum)
        if not hum or hum.Health <= 0 then return end
        if model:FindFirstChildOfClass("Humanoid") ~= hum then return end
        if M.ArmedOnly and not isArmed(model) then return end
        local head = model:FindFirstChild("Head")
        if not head then return end
        local ok, pos = pcall(function() return model:GetPivot().Position end)
        if not ok then return end
        local d = (pos - mp).Magnitude
        if d > 340 then return end
        table.insert(out, { model = model, hum = hum, head = head, dist = d })
    end
    if M.KillNPC then
        for _, m in ipairs(Workspace:GetChildren()) do
            if m.Name == "NPC" then
                local h = m:FindFirstChildOfClass("Humanoid")
                if h then push(m, h) end
            end
        end
    end
    if M.KillPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h then push(p.Character, h) end
            end
        end
    end
    table.sort(out, function(a, b) return a.dist < b.dist end)
    return out
end

local function openAllDoors()
    local change = getNet("ChangeDoor")
    if not change then return end
    for _, d in ipairs(CollectionService:GetTagged("EnterableDoor")) do
        if not alive() then break end
        pcall(function() change:FireServer(d, "Open") end)
        task.wait(0.2)
    end
end

local function shoutAll()
    local shout = getNet("ShoutNPC")
    if not shout then return end
    for _, m in ipairs(CollectionService:GetTagged("NPC")) do
        if not alive() then break end
        pcall(function() shout:FireServer(m) end)
        task.wait(0.2)
    end
end

