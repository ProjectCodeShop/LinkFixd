local function ProcessNotifQueue()
    if isNotifShowing or #notifQueue == 0 then return end
    isNotifShowing = true
    local item = table.remove(notifQueue, 1)
    NotifTitle.Text = item.Title or "MagicAlay Hub"
    NotifSub.Text = item.Message or ""
    
    NotificationBanner.Visible = true
    PlaySound(SOUND_NOTIF)

    TweenService:Create(NotificationBanner, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -130, 0, 18),
        BackgroundTransparency = 0.08
    }):Play()
    TweenService:Create(NotifIconBox, TweenInfo.new(0.35), {BackgroundTransparency = 0.08}):Play()
    TweenService:Create(NotifTitle, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(NotifSub, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(NotifImg, TweenInfo.new(0.3), {ImageTransparency = 0}):Play()
    TweenService:Create(NotifStroke, TweenInfo.new(0.3), {Transparency = 0.65}):Play()

    task.delay(2.5, function()
        local tw = TweenService:Create(NotificationBanner, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, -130, 0, -80),
            BackgroundTransparency = 1
        })
        TweenService:Create(NotifIconBox, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
        TweenService:Create(NotifTitle, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
        TweenService:Create(NotifSub, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
        TweenService:Create(NotifImg, TweenInfo.new(0.2), {ImageTransparency = 1}):Play()
        TweenService:Create(NotifStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
        
        tw:Play()
        tw.Completed:Connect(function()
            NotificationBanner.Visible = false
            isNotifShowing = false
            task.wait(0.08)
            ProcessNotifQueue()
        end)
    end)
end

