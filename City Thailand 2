local lastCamCF = Camera.CFrame
RunService.RenderStepped:Connect(function()
    if getgenv().MotionBlur_Enabled then
        pcall(function()
            local currentCamCF = Camera.CFrame
            local lookVectorDiff = (currentCamCF.LookVector - lastCamCF.LookVector).Magnitude
            local rotSpeed = lookVectorDiff * 60 
            local speedMetric = rotSpeed * (getgenv().MotionBlur_Intensity * 0.15)
            local targetSize = math.clamp(speedMetric, 0, 35)
            
            MotionBlurEffect.Size = targetSize
            lastCamCF = currentCamCF
        end)
    else
        MotionBlurEffect.Size = 0
    end
end)

