                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                if root and hum then
                    local folder = Workspace:FindFirstChild("HalloweenTokenFolder")
                    if folder then
                        local tokens = folder:FindFirstChild("Tokens")
                        if tokens then
                            for _, tokenObj in ipairs(tokens:GetChildren()) do
                                if not getgenv().AutoFarm_Enabled then break end
                                local targetCF = nil
