                                elseif tokenObj:IsA("Model") and tokenObj.PrimaryPart then
                                    targetCF = tokenObj.PrimaryPart.CFrame
                                elseif tokenObj:IsA("Model") then
                                    local p = tokenObj:FindFirstChildWhichIsA("BasePart")
                                    if p then targetCF = p.CFrame end
                                end

                                if targetCF then
                                    root.CFrame = targetCF
                                    task.wait(getgenv().TokenFarm_Delay)
                                    root.CFrame = FARM_COORD
                                    task.wait(getgenv().TokenFarm_Delay)
                                end
                            end
                        end
                    end
                end
