local function Row(parent, title, desc, opts)
    opts = opts or {}
    local h = opts.Height or (desc and 50 or 40)
    local r = New(opts.Click and "TextButton" or "Frame", { Size = U(1, 0, 0, h), BackgroundColor3 = opts.Color or ROW }, parent)
    if opts.Click then
        r.Text = ""
        r.AutoButtonColor = false
        PressEffect(r, 0.98)
    end
    Corner(r, 9)
    local pad = opts.RightPad or 64
    local t = Label(r, { Size = U(1, -pad, 0, 16), Position = U(0, 12, 0, desc and 8 or (h - 16) / 2), Text = title, Font = FB, TextSize = 12.5, TextTruncate = TRUNC })
    local d
    if desc then
        d = Label(r, {
            Size = U(1, -pad, 0, h - 28), Position = U(0, 12, 0, 26), Text = desc, TextSize = 10, TextColor3 = SUB,
            TextWrapped = opts.Wrap or false, TextYAlignment = Enum.TextYAlignment.Top,
            TextTruncate = opts.Wrap and Enum.TextTruncate.None or TRUNC
