local currentActiveCallback = nil

local function OpenGameDetail(title, desc, placeId, customImg, fallbackId, callbackFunc)
    PlaySound(SOUND_CLICK)
    DetailTitleLabel.Text = title
    currentActiveCallback = callbackFunc

    if desc and desc ~= "" then
        DetailDescLabel.Text = desc
    else
        DetailDescLabel.Text = "No description provided."
    end
    
    if placeId and placeId ~= 0 and placeId ~= "" then
        ApplyImageAsset(DetailBannerImg, fallbackId or RAW_ASSET_ID)
        task.spawn(function()
            pcall(function()
                local productInfo = MarketplaceService:GetProductInfo(tonumber(placeId), Enum.InfoType.Asset)
                if productInfo then
                    if productInfo.IconImageAssetId then
                        DetailBannerImg.Image = "rbxassetid://" .. tostring(productInfo.IconImageAssetId)
                    else
                        DetailBannerImg.Image = "rbxthumb://type=Asset&id=" .. tostring(placeId) .. "&w=420&h=420"
                    end
                    if (not desc or desc == "") and productInfo.Description and productInfo.Description ~= "" then
                        DetailDescLabel.Text = productInfo.Description
                    end
                end
            end)
        end)
    elseif customImg and customImg ~= "" then
        DetailBannerImg.Image = "rbxassetid://" .. tostring(customImg)
    else
        ApplyImageAsset(DetailBannerImg, fallbackId or RAW_ASSET_ID)
    end
    
    DetailModalOverlay.Visible = true
    TweenService:Create(DetailModalOverlay, TweenInfo.new(0.25), {BackgroundTransparency = 0.45}):Play()
    
    DetailCard.Size = UDim2.new(0, 240, 0, 190)
    DetailCard.Position = UDim2.new(0.5, -120, 0.5, -95)
    
    -- Smooth Staggered Modal Fade In
    TweenService:Create(DetailCard, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 270, 0, 215),
        Position = UDim2.new(0.5, -135, 0.5, -107.5),
        BackgroundTransparency = 0.08
    }):Play()
    TweenService:Create(DetailBannerImg, TweenInfo.new(0.3), {ImageTransparency = 0}):Play()
    TweenService:Create(DetailTitleLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(DetailDescLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    
    TweenService:Create(DetailCloseBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0.2}):Play()
    TweenService:Create(CancelBtnStroke, TweenInfo.new(0.3), {Transparency = 0.45}):Play()
    TweenService:Create(CancelIcon, TweenInfo.new(0.3), {ImageTransparency = 0}):Play()
    TweenService:Create(CancelText, TweenInfo.new(0.3), {TextTransparency = 0}):Play()

    TweenService:Create(DetailExecBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0.1}):Play()
    TweenService:Create(ExecBtnStroke, TweenInfo.new(0.3), {Transparency = 0.5}):Play()
    TweenService:Create(ExecIcon, TweenInfo.new(0.3), {ImageTransparency = 0}):Play()
    TweenService:Create(ExecText, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
end

