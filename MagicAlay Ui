        MainFrame.Size = UDim2.new(0, 36, 0, 36)
        MainFrame.Position = TargetPosition + UDim2.new(0, MainWidth/2 - 18, 0, MainHeight/2 - 18)
        
        local openTween = TweenService:Create(MainFrame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, MainWidth, 0, MainHeight),
            Position = TargetPosition
        })
        openTween:Play()
        PlayTabStaggerAnimation()
    else
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 18, 0, 18),
            Position = TargetPosition + UDim2.new(0, MainWidth/2 - 9, 0, MainHeight/2 - 9)
