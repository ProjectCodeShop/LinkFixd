local function OpenGameDetail(title, desc, placeId, customImg, fallbackId, callbackFunc)
    PlaySound(SOUND_CLICK)
    DetailTitle.Text = title
    currentActiveCallback = callbackFunc
    DetailDesc.Text = (desc and desc ~= "") and desc or "No description provided."
    if placeId and placeId ~= 0 and placeId ~= "" then
        ApplyImageAsset(DetailBanner, fallbackId or RAW_ASSET_ID)
        task.spawn(function()
            pcall(function()
                local info = MarketplaceService:GetProductInfo(tonumber(placeId), Enum.InfoType.Asset)
