    local line = New("Frame", { Size = U(1, -60, 0, 1), Position = U(0, 60, 0.5, 1), BackgroundColor3 = LINE, BackgroundTransparency = 0.35 }, h)
    New("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, line)
    local function place()
        local w = lbl.TextBounds.X + 12
        line.Position = U(0, w, 0.5, 1)
        line.Size = U(1, -(w + 4), 0, 1)
    end
    place()
    lbl:GetPropertyChangedSignal("TextBounds"):Connect(place)
    return h
end

