                    if info.IconImageAssetId then
                        DetailBanner.Image = "rbxassetid://" .. tostring(info.IconImageAssetId)
                    else
                        DetailBanner.Image = "rbxthumb://type=Asset&id=" .. tostring(placeId) .. "&w=420&h=420"
                    end
                    if (not desc or desc == "") and info.Description and info.Description ~= "" then DetailDesc.Text = info.Description end
                end
            end)
        end)
    elseif customImg and customImg ~= "" then
        DetailBanner.Image = "rbxassetid://" .. tostring(customImg)
    else
        ApplyImageAsset(DetailBanner, fallbackId or RAW_ASSET_ID)
    end
    DetailOverlay.Visible = true
    DetailScale.Scale = 0.9
