local runningUrls = {}
local function RunScriptUrl(url)
    if not url or url == "" then
        ShowiOSNotification("Script", "This item has no script link")
        return
    end
    if runningUrls[url] then
        ShowiOSNotification("Script", "Already loading, please wait...")
        return
    end
    runningUrls[url] = true
    task.spawn(function() -- รันในเธรดแยก UI ไม่ค้าง
        local code
        for i = 1, 3 do -- ลองใหม่ 3 รอบ
            local ok, res = pcall(function() return game:HttpGet(url) end)
            if ok and type(res) == "string" and #res > 0 then code = res break end
            if ORIG_REQUEST then
                local ok2, r = pcall(ORIG_REQUEST, { Url = url, Method = "GET" })
                if ok2 and type(r) == "table" and type(r.Body) == "string" and #r.Body > 0 and (r.StatusCode or 200) < 400 then
                    code = r.Body break
                end
            end
            task.wait(0.6 * i)
        end
        if not code then
            ShowiOSNotification("Script Error", "Could not download script. Check internet", true)
        else
            local fn, cerr = loadstring(code)
            if not fn then
                warn("[MagicAlay] compile error: " .. tostring(cerr))
                ShowiOSNotification("Script Error", "Script is broken or outdated", true)
            else
                local ok, err = pcall(fn)
                if not ok then
                    warn("[MagicAlay] script error: " .. tostring(err))
                    ShowiOSNotification("Script Error", "The script failed to run", true)
                else
                    ShowiOSNotification("Script", "Loaded successfully")
                end
            end
        end
        task.delay(1.5, function() runningUrls[url] = nil end)
    end)
end

local function GetProduct(placeId)
    local key = tostring(placeId)
    if productCache[key] == nil then
        local ok, info = pcall(function() return MarketplaceService:GetProductInfo(tonumber(placeId), Enum.InfoType.Asset) end)
        productCache[key] = (ok and info) or false
    end
    return productCache[key] or nil
end

local function LoadGameIcon(img, placeId, customImage, fallbackId, size, onInfo)
    if placeId and placeId ~= 0 and placeId ~= "" then
        ApplyImageAsset(img, fallbackId or RAW_ASSET_ID)
        task.spawn(function()
            local info = GetProduct(placeId)
            if info and img.Parent then
                if info.IconImageAssetId then
                    img.Image = "rbxassetid://" .. tostring(info.IconImageAssetId)
                else
                    img.Image = "rbxthumb://type=Asset&id=" .. tostring(placeId) .. "&w=" .. tostring(size) .. "&h=" .. tostring(size)
                end
                if onInfo then onInfo(info) end
            end
        end)
    elseif customImage and customImage ~= "" then
        img.Image = "rbxassetid://" .. tostring(customImage)
    else
        ApplyImageAsset(img, fallbackId or RAW_ASSET_ID)
    end
end

