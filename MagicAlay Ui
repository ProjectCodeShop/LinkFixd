local function MakeStableDraggable(frame, button, clickCallback)
    local dragging = false
    local dragStart = Vector3.new()
    local startPos = UDim2.new()
    local hasMoved = false

    local function updateDrag(input)
        local delta = input.Position - dragStart
        if delta.Magnitude > 6 then hasMoved = true end
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            hasMoved = false
            dragStart = input.Position
            startPos = frame.Position

            local changedConnection
            changedConnection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if changedConnection then changedConnection:Disconnect() end
                    if not hasMoved and clickCallback then clickCallback() end
                end
            end)
        end
    end)

    button.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateDrag(input)
        end
    end)
end

