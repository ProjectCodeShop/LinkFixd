-- ==================== SPLASH INTRO (PROFESSIONAL) ====================
-- โลโก้ → แบนเนอร์ แล้วเข้าฮับ (อินโทรแบบสั้น)
local introDone = Instance.new("BindableEvent")
local introRunning = false

PlayIntro = function(onFinish)
    if introRunning then return end
    introRunning = true
    task.spawn(function()
        local Overlay
        local skipped, alive = false, true
        local ok, err = pcall(function()
            local Quart, Quad = Enum.EasingStyle.Quart, Enum.EasingStyle.Quad
            local Back, Expo = Enum.EasingStyle.Back, Enum.EasingStyle.Exponential
            local Out, In, InOut = Enum.EasingDirection.Out, Enum.EasingDirection.In, Enum.EasingDirection.InOut
            local C = Vector2.new(0.5, 0.5)

            local function Wait(t)
                local e = os.clock() + t
                while os.clock() < e and not skipped do task.wait() end
            end
            local function Tw(obj, t, props, style, dir)
                local tw = TweenService:Create(obj, TweenInfo.new(t, style or Quart, dir or Out), props)
                tw:Play()
                return tw
            end

            -- พื้นมืด (กดเพื่อข้าม)
            Overlay = New("TextButton", {
                Size = U(1, 0, 1, 0), BackgroundColor3 = RGB(5, 6, 14), BackgroundTransparency = 1,
                Text = "", AutoButtonColor = false, ZIndex = 400
            }, ScreenGui)
            Overlay.Activated:Connect(function() skipped = true end)

            -- ทุกอย่างอยู่ใน Root เพื่อเฟดออกทีเดียว (กันบัคตอนข้าม)
            local Root = New("CanvasGroup", {
                Size = U(1, 0, 1, 0), BackgroundTransparency = 1, GroupTransparency = 0, ZIndex = 401, Active = false
            }, Overlay)

            -- โลโก้
            local Logo = New("ImageLabel", {
                Size = U(0, 110, 0, 110), AnchorPoint = C, Position = U(0.5, 0, 0.5, 0),
                BackgroundTransparency = 1, ImageTransparency = 1, ScaleType = Enum.ScaleType.Fit, ZIndex = 410
            }, Root)
            Logo.Image = "rbxassetid://" .. tostring(BRAND_LOGO_ID)
            local LogoScale = New("UIScale", { Scale = 0.6 }, Logo)

            -- วงแหวนขยายออกจากโลโก้
            local function Ring(delay)
                task.delay(delay, function()
                    if not (alive and Root.Parent) then return end
                    local r = New("Frame", {
                        Size = U(0, 110, 0, 110), AnchorPoint = C, Position = U(0.5, 0, 0.5, 0),
                        BackgroundTransparency = 1, ZIndex = 409
                    }, Root)
                    New("UICorner", { CornerRadius = UDim.new(0.5, 0) }, r)
                    local st = Stroke(r, 0.25, 1.5, ACC2)
                    Tw(r, 1.4, { Size = U(0, 270, 0, 270) }, Expo, Out)
                    Tw(st, 1.4, { Transparency = 1 }, Quad, Out)
                    task.delay(1.5, function() r:Destroy() end)
                end)
            end

            -- แฟลชขาวเบา ๆ
            local Flash = New("Frame", { Size = U(1, 0, 1, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 430, Active = false }, Root)

            -- แบนเนอร์
            local BannerHolder = New("Frame", {
                Size = U(0, 400, 0, 150), AnchorPoint = C, Position = U(0.5, 0, 0.5, 0),
                BackgroundColor3 = BG, BackgroundTransparency = 1, ZIndex = 410, ClipsDescendants = true
            }, Root)
            Corner(BannerHolder, 14)
            local BannerStroke = Stroke(BannerHolder, 1, 1.2, ACC2)
            local BannerImg = New("ImageLabel", {
                Size = U(1, 0, 1, 0), BackgroundTransparency = 1, ImageTransparency = 1,
                ScaleType = Enum.ScaleType.Crop, ZIndex = 411
            }, BannerHolder)
            BannerImg.Image = "rbxassetid://" .. tostring(BANNER_ID)
            local BannerScale = New("UIScale", { Scale = 0.9 }, BannerHolder)
            local Shine = New("Frame", {
                Size = U(0.28, 0, 1.7, 0), AnchorPoint = C, Position = U(-0.3, 0, 0.5, 0), Rotation = 18,
                BackgroundColor3 = WHITE, BackgroundTransparency = 0.8, ZIndex = 413
            }, BannerHolder)
            New("UIGradient", { Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1)
            }) }, Shine)

            -- ข้อความ skip
            local Skip = Label(Root, {
                Size = U(1, 0, 0, 14), AnchorPoint = Vector2.new(0, 1), Position = U(0, 0, 1, -14),
                Text = "Tap anywhere to skip", TextSize = 9.5, TextColor3 = DIM, TextXAlignment = XC, TextTransparency = 1, ZIndex = 410
            })

            -- โหลดรูปให้เสร็จก่อนเริ่ม (กันภาพกระตุกรอบแรก)
            local loaded = false
            task.spawn(function()
                pcall(function() game:GetService("ContentProvider"):PreloadAsync({ Logo, BannerImg }) end)
                loaded = true
            end)
            local waited = os.clock()
            while not loaded and os.clock() - waited < 3 and not skipped do task.wait() end

            PlaySound("rbxassetid://140419294351439")

            -- 1) มืด + เบลอ
            Tw(Overlay, 0.5, { BackgroundTransparency = 0.04 }, Quad, Out)
            Tw(BlurEffect, 0.7, { Size = 20 }, Quart, Out)
            Tw(Skip, 0.6, { TextTransparency = 0.4 }, Quad, Out)
            Wait(0.45)

            -- 2) โลโก้เด้งเข้า + วงแหวน
            if not skipped then
                Logo.Rotation = -10
                Tw(Flash, 0.1, { BackgroundTransparency = 0.7 }, Quad, Out)
                task.delay(0.12, function() Tw(Flash, 0.6, { BackgroundTransparency = 1 }, Quad, Out) end)
                Tw(Logo, 0.8, { ImageTransparency = 0, Rotation = 0 }, Back, Out)
                Tw(LogoScale, 1.0, { Scale = 1 }, Back, Out)
                Ring(0.05)
                Ring(0.4)
                Wait(1.5)
            end

            -- 3) โลโก้จางหาย → แบนเนอร์ขึ้นมา + แสงวิ่งผ่าน
            if not skipped then
                Tw(Logo, 0.4, { ImageTransparency = 1 }, Quad, In)
                Tw(LogoScale, 0.4, { Scale = 1.12 }, Quad, In)
                Tw(Skip, 0.3, { TextTransparency = 1 }, Quad, In)
                Wait(0.45)
            end
            if not skipped then
                Tw(BannerHolder, 0.6, { BackgroundTransparency = 0 }, Quad, Out)
                Tw(BannerImg, 0.7, { ImageTransparency = 0 }, Quad, Out)
                Tw(BannerStroke, 0.7, { Transparency = 0.5 }, Quad, Out)
                Tw(BannerScale, 1.0, { Scale = 1 }, Back, Out)
                Wait(0.5)
                Tw(Shine, 0.9, { Position = U(1.3, 0, 0.5, 0) }, Quad, InOut)
                Wait(1.5)
            end

            -- 4) ปิดอินโทร (จบปกติและกดข้ามใช้ทางเดียวกัน)
            alive = false
            local fade = skipped and 0.3 or 0.5
            Tw(Root, fade, { GroupTransparency = 1 }, Quad, In)
            Tw(Overlay, fade, { BackgroundTransparency = 1 }, Quad, In)
            task.wait(fade + 0.1)
        end)
        alive = false
        if not ok then warn("[MagicAlay Intro]: " .. tostring(err)) end
        if Overlay then pcall(function() Overlay:Destroy() end) end
        introRunning = false
        if ScreenGui.Parent then
            UpdateBlurState()
            if onFinish then onFinish() end
        end
    end)
end

