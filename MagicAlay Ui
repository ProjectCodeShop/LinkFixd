-- Tab System Setup
local Tabs = {}

-- ฟังก์ชันสำหรับเล่น Stagger Animation เมื่อเปิดหน้าต่างแต่ละหน้า
local function AnimatePageContent(pageFrame)
    local items = {}
    for _, desc in ipairs(pageFrame:GetDescendants()) do
        if desc:IsA("Frame") and desc.Parent:IsA("ScrollingFrame") then
            table.insert(items, desc)
        elseif desc:IsA("TextButton") and desc.Name == "Card" then
            table.insert(items, desc)
        end
    end

    for i, item in ipairs(items) do
        local origY = item.Position.Y.Offset
        item.Position = UDim2.new(item.Position.X.Scale, item.Position.X.Offset, item.Position.Y.Scale, origY + 15)
        
        -- ค่อยๆ จางขึ้นมาและลอยขึ้น
        for _, child in ipairs(item:GetDescendants()) do
            if child:IsA("TextLabel") then child.TextTransparency = 1
            elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then child.ImageTransparency = 1
            elseif child:IsA("UIStroke") then child.Transparency = 1 end
        end

        task.delay((i - 1) * 0.05, function()
            if item and item.Parent then
                TweenService:Create(item, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Position = UDim2.new(item.Position.X.Scale, item.Position.X.Offset, item.Position.Y.Scale, origY)
                }):Play()

                for _, child in ipairs(item:GetDescendants()) do
                    if child:IsA("TextLabel") then
                        TweenService:Create(child, TweenInfo.new(0.25), {TextTransparency = 0}):Play()
                    elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
                        TweenService:Create(child, TweenInfo.new(0.25), {ImageTransparency = 0}):Play()
                    elseif child:IsA("UIStroke") then
                        TweenService:Create(child, TweenInfo.new(0.25), {Transparency = 0.88}):Play()
                    end
                end
            end
        end)
    end
end

local function CreateTab(tabName, rawIconId)
    local TabButton = Instance.new("TextButton")
    TabButton.Size = UDim2.new(1, 0, 0, 28)
    TabButton.BackgroundTransparency = 1
    TabButton.Text = ""
    TabButton.AutoButtonColor = false
    TabButton.ZIndex = 3
    TabButton.Parent = TabButtonContainer

    local TabIcon = Instance.new("ImageLabel")
    TabIcon.Size = UDim2.new(0, 14, 0, 14)
    TabIcon.Position = UDim2.new(0, 6, 0.5, -7)
    TabIcon.BackgroundTransparency = 1
    TabIcon.ImageColor3 = Color3.fromRGB(160, 165, 185)
    TabIcon.ZIndex = 4
    TabIcon.Parent = TabButton
    ApplyImageAsset(TabIcon, rawIconId or RAW_ASSET_ID)

    local TabLabel = Instance.new("TextLabel")
    TabLabel.Size = UDim2.new(1, -24, 1, 0)
    TabLabel.Position = UDim2.new(0, 24, 0, 0)
    TabLabel.Text = tabName
    TabLabel.Font = Enum.Font.GothamMedium
    TabLabel.TextSize = 8.5
    TabLabel.TextColor3 = Color3.fromRGB(160, 165, 185)
    TabLabel.TextXAlignment = Enum.TextXAlignment.Left
    TabLabel.BackgroundTransparency = 1
    TabLabel.ZIndex = 4
    TabLabel.Parent = TabButton

    local ContentArea = Instance.new("Frame")
    ContentArea.Size = UDim2.new(1, -133, 1, -48)
    ContentArea.Position = UDim2.new(0, 125, 0, 38)
    ContentArea.BackgroundTransparency = 1
    ContentArea.Visible = false
    ContentArea.Parent = PagesFolder

    local function SelectTab()
        PlaySound(SOUND_MENU)
        TabIndicator.Visible = true
        for _, tabData in pairs(Tabs) do
            tabData.Page.Visible = false
            if tabData.Button.Visible then
                TweenService:Create(tabData.Icon, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(160, 165, 185)}):Play()
                TweenService:Create(tabData.Label, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(160, 165, 185)}):Play()
            end
        end
        ContentArea.Visible = true
        
        -- เล่น Stagger Animation ให้ทุก Element ในหน้าที่กดเปิดทันที
        AnimatePageContent(ContentArea)

        local targetY = TabButton.AbsolutePosition.Y - TabButtonContainer.AbsolutePosition.Y
        TweenService:Create(TabIndicator, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 5, 0, math.clamp(targetY + 5, 5, BottomDock.AbsoluteSize.Y - 35)),
            Size = UDim2.new(1, -10, 0, TabButton.AbsoluteSize.Y)
        }):Play()

        TweenService:Create(TabIcon, TweenInfo.new(0.2), {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        TweenService:Create(TabLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    end

    TabButton.MouseButton1Click:Connect(SelectTab)
    local tabObj = {
        Name = tabName,
        Button = TabButton,
        Icon = TabIcon,
        Label = TabLabel,
        Page = ContentArea,
        Select = SelectTab
    }
    table.insert(Tabs, tabObj)
    return tabObj
end

local function PlayTabStaggerAnimation()
    local visibleTabs = {}
    for _, tab in ipairs(Tabs) do
        if tab.Button.Visible then table.insert(visibleTabs, tab) end
    end

    for i, tab in ipairs(visibleTabs) do
        tab.Button.Position = UDim2.new(0, 0, 0, -15)
        tab.Icon.ImageTransparency = 1
        tab.Label.TextTransparency = 1

        task.delay((i - 1) * 0.08, function()
            if tab.Button and tab.Button.Parent then
                TweenService:Create(tab.Button, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Position = UDim2.new(0, 0, 0, 0)
                }):Play()
                TweenService:Create(tab.Icon, TweenInfo.new(0.3), {ImageTransparency = 0}):Play()
                TweenService:Create(tab.Label, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
            end
        end)
    end
end

