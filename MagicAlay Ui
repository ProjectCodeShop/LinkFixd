-- Anti-Lag: ตัดเอฟเฟกต์หนัก + ปิดการหน่วงฟิสิกส์/การรับข้อมูล
local lagOrig, lagConn
local function KillFx(v)
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke")
        or v:IsA("Fire") or v:IsA("Sparkles") then
        if v.Enabled then lagOrig.Fx[v] = true v.Enabled = false end
    end
end
local function ApplyAntiLag(on)
    pcall(function()
        if on then
            if lagOrig then return end
            lagOrig = { Fx = setmetatable({}, { __mode = "k" }) }
            pcall(function()
                lagOrig.Throttle = settings().Physics.PhysicsEnvironmentalThrottle
                settings().Physics.PhysicsEnvironmentalThrottle = Enum.EnviromentalPhysicsThrottle.Disabled
            end)
            pcall(function()
                lagOrig.Repl = settings().Network.IncomingReplicationLag
                settings().Network.IncomingReplicationLag = 0
            end)
            lagConn = Workspace.DescendantAdded:Connect(function(v) if lagOrig then pcall(KillFx, v) end end)
            task.spawn(function()
                for i, v in ipairs(Workspace:GetDescendants()) do
                    if not lagOrig then return end
                    pcall(KillFx, v)
                    if i % 400 == 0 then task.wait() end
                end
            end)
        elseif lagOrig then
            if lagConn then lagConn:Disconnect() lagConn = nil end
            pcall(function() if lagOrig.Throttle then settings().Physics.PhysicsEnvironmentalThrottle = lagOrig.Throttle end end)
            pcall(function() if lagOrig.Repl then settings().Network.IncomingReplicationLag = lagOrig.Repl end end)
            for v in pairs(lagOrig.Fx) do pcall(function() v.Enabled = true end) end
            lagOrig = nil
        end
    end)
end

-- Smooth Mode: เงา น้ำ ภูมิประเทศ แสง
local smoothOrig
local function ApplySmooth(on)
    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if on then
            if smoothOrig then return end
            smoothOrig = { Soft = Lighting.ShadowSoftness, Shadows = Lighting.GlobalShadows,
                Deco = terrain and terrain.Decoration, Wave = terrain and terrain.WaterWaveSize,
                Speed = terrain and terrain.WaterWaveSpeed }
            Lighting.ShadowSoftness = 0
            Lighting.GlobalShadows = false
            if terrain then
                pcall(function() terrain.Decoration = false end)
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
            end
            if sethiddenproperty then pcall(sethiddenproperty, Lighting, "Technology", Enum.Technology.Legacy) end
        elseif smoothOrig then
            Lighting.ShadowSoftness = smoothOrig.Soft
            Lighting.GlobalShadows = smoothOrig.Shadows
            if terrain then
                pcall(function() terrain.Decoration = smoothOrig.Deco end)
                terrain.WaterWaveSize = smoothOrig.Wave
                terrain.WaterWaveSpeed = smoothOrig.Speed
            end
            smoothOrig = nil
        end
    end)
end

-- Potato Mode: ผิววัสดุเรียบ ปิดเงา/ดีคอล (ลดภาระ GPU มากสุด)
local potato, potatoConn
local function Potatoize(v)
    if v:IsA("BasePart") then
        local m = v:FindFirstAncestorOfClass("Model")
        if m and m:FindFirstChildOfClass("Humanoid") then return end -- ไม่แตะตัวละคร
        if not potato.P[v] then potato.P[v] = { v.Material, v.Reflectance, v.CastShadow } end
        v.Material = Enum.Material.SmoothPlastic
        v.Reflectance = 0
        v.CastShadow = false
    elseif v:IsA("Decal") or v:IsA("Texture") then
        if not potato.D[v] then potato.D[v] = v.Transparency end
        v.Transparency = 1
    end
end
local function ApplyPotato(on)
    pcall(function()
        if on then
            if potato then return end
            potato = { P = setmetatable({}, { __mode = "k" }), D = setmetatable({}, { __mode = "k" }) }
            pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04 end)
            potatoConn = Workspace.DescendantAdded:Connect(function(v) if potato then pcall(Potatoize, v) end end)
            task.spawn(function()
                for i, v in ipairs(Workspace:GetDescendants()) do
                    if not potato then return end
                    pcall(Potatoize, v)
                    if i % 300 == 0 then task.wait() end
                end
            end)
        elseif potato then
            if potatoConn then potatoConn:Disconnect() potatoConn = nil end
            for v, d in pairs(potato.P) do pcall(function() v.Material, v.Reflectance, v.CastShadow = d[1], d[2], d[3] end) end
            for v, t in pairs(potato.D) do pcall(function() v.Transparency = t end) end
            potato = nil
        end
    end)
end

