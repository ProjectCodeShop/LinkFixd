local function SetTabState(unlocked)
    isUnlocked = unlocked
    if not unlocked then
        LoginTab.Button.Visible = true
        RecTab.Button.Visible = false
        FavTab.Button.Visible = false
        DiscordTab.Button.Visible = false
        CreditTab.Button.Visible = false
        SettingsTab.Button.Visible = false
        LoginTab.Select()
    else
        LoginTab.Button.Visible = false
        RecTab.Button.Visible = true
        FavTab.Button.Visible = true
        DiscordTab.Button.Visible = true
        CreditTab.Button.Visible = true
        SettingsTab.Button.Visible = true
        RecTab.Select()
    end
    PlayTabStaggerAnimation()
end

OnUnlockSystem = function()
    SetTabState(true)
end

RefreshFavoritesUI = function()
    for _, child in pairs(FavContainer:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for title, data in pairs(favoriteScripts) do
        local callbackFunc = function()
            if data.Url and data.Url ~= "" then
                pcall(function() loadstring(game:HttpGet(data.Url))() end)
            elseif allLoadedScripts[title] and allLoadedScripts[title].Url then
                pcall(function() loadstring(game:HttpGet(allLoadedScripts[title].Url))() end)
            end
        end
        AddScriptCard(FavContainer, data.Title, data.Desc or "Game Script", data.PlaceId, data.CustomImage, data.FallbackIconId or RAW_ASSET_ID, data.Url or (allLoadedScripts[title] and allLoadedScripts[title].Url))
    end
    AnimatePageContent(FavTab.Page)
end

