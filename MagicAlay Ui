-- ==================== GLOBAL SHIELD SYSTEM ====================
local protect_env = getgenv and getgenv() or _ENV or shared

-- รันซ้ำ: ล้าง UI ตัวเก่าก่อน และใช้ request ตัวจริงที่เก็บไว้ (ไม่ใช่ตัวที่โดน Shield ครอบ)
if protect_env.MagicAlayCleanup then pcall(protect_env.MagicAlayCleanup) end
local ORIG_REQUEST = protect_env.MagicAlayOrigRequest or request or (syn and syn.request) or http_request or (fluxus and fluxus.request) or (Krnl and Krnl.request)
protect_env.MagicAlayOrigRequest = ORIG_REQUEST

if not protect_env.MagicAlayShieldInstalled then
    protect_env.MagicAlayShieldInstalled = true
    pcall(function()
        local function isHook(url)
            if type(url) == "table" then url = url.Url or url.url end
            return type(url) == "string" and (string.find(url, "discord.com/api/webhooks") or string.find(url, "webhook") or string.find(url, "api/log"))
        end
        local function wrap(old)
            return function(data)
                if type(data) == "table" and isHook(data.Url or data.url or "") then
                    warn("[Shield Global]: บล็อกการส่งข้อมูลไปยัง Webhook -> " .. tostring(data.Url or data.url))
                    return { Success = true, StatusCode = 200, Body = '{"success":true}' }
                end
                return old(data)
            end
        end
        if protect_env.request then protect_env.request = wrap(protect_env.request) end
        if syn and syn.request then syn.request = wrap(syn.request) end
        if protect_env.http_request then protect_env.http_request = wrap(protect_env.http_request) end

        if hookmetamethod and getnamecallmethod then
            local wrapC = newcclosure or function(f) return f end
            local oldNamecall
            local newNamecall = wrapC(function(self, ...)
                local method = getnamecallmethod()
                if method == "PostAsync" or method == "RequestAsync" then
                    if isHook((...)) then
                        warn("[Shield Global]: บล็อก HttpService สำเร็จ")
                        return '{"success": true}'
                    end
                end
                return oldNamecall(self, ...)
            end)
            oldNamecall = hookmetamethod(game, "__namecall", newNamecall)
            protect_env.MagicAlayExpectedNamecall = newNamecall

            -- ตรวจจับการ hook ทับระบบป้องกันภายหลัง (Anti-Hook / Tamper Detection)
            if getrawmetatable then
                task.spawn(function()
                    while protect_env.MagicAlayShieldInstalled do
                        task.wait(5)
                        pcall(function()
                            local mt = getrawmetatable(game)
                            local current = mt and mt.__namecall
                            if current and current ~= protect_env.MagicAlayExpectedNamecall then
                                warn("[Shield Global]: ตรวจพบการ hook ทับระบบป้องกัน (อาจมีสคริปต์อื่นแทรกแซง)")
                            end
                        end)
                    end
                end)
            end
        end

        -- ป้องกันการดึง source / decompile สคริปต์ (Anti-Dump)
        pcall(function()
            local dumpFuncs = {
                "decompile", "dumpstring", "dumpstr", "getscriptbytecode",
                "getscriptclosure", "getscripthash", "getscriptfunctions", "savestring"
            }
            local blocker = (newcclosure or function(f) return f end)(function()
                warn("[Shield Global]: บล็อกการพยายามดึง source ของสคริปต์")
                return nil
            end)
            if hookfunction then
                for _, fname in ipairs(dumpFuncs) do
                    local target = protect_env[fname]
                    if type(target) == "function" then
                        pcall(function() hookfunction(target, blocker) end)
                    end
                end
            end
        end)
    end)
    print("ติดตั้งระบบป้องกันระดับ Global สำเร็จ!")
end

