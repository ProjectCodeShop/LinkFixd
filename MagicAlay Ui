local function PopulateExtras(ui, items)
    local feat, ordered, seen, cur = {}, {}, {}, {}
    for _, it in ipairs(items) do
        if IsCurrentGame(it.PlaceId) then table.insert(cur, it) end
        if it.Featured or it.Recommended or it.Hot then table.insert(feat, it) end
    end
    if #feat == 0 then
        for i = 1, math.min(6, #items) do table.insert(feat, items[i]) end
    end
    for _, list in ipairs({ cur, feat }) do
        for _, it in ipairs(list) do
            if not seen[it] then
                seen[it] = true
                table.insert(ordered, it)
            end
        end
    end
    ui.RecoCount = #ordered
    ui.Ordered = ordered
    for _, it in ipairs(ordered) do AddFeaturedCard(ui.RecoRow, it) end
    ui.Reco.Visible = #ordered > 0
    if #cur > 0 then AddDetectedCard(ui.Detected, cur[1]) end
end

