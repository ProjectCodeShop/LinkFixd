local function ShowUpdate(data)
    local notes = data.Notes or data.Changes or {}
    if type(notes) == "string" then notes = { notes } end
    local lines = {}
    for _, n in ipairs(notes) do table.insert(lines, "•  " .. tostring(n)) end
    UpdateTitle.Text = tostring(data.Title or "What's New")
    local meta = {}
    if data.Version then table.insert(meta, "Version " .. tostring(data.Version)) end
    if data.Date then table.insert(meta, tostring(data.Date)) end
    UpdateMeta.Text = table.concat(meta, "  ·  ")
    local isNew = data.Version ~= nil and tostring(data.Version) ~= HUB_VERSION
    UpdateTagText.Text = isNew and "NEW VERSION" or "WHAT'S NEW"
    UpdateBody.Text = (#lines > 0) and table.concat(lines, "\n") or tostring(data.Message or "No details provided.")
    UpdateBox.CanvasPosition = Vector2.new(0, 0)
    updateId = tostring(data.Id or data.Version or data.Title or "update")
    updateShown = true
    PlaySound(SOUND_NOTIF)
    UpdateOverlay.Visible = true
    UpdateScale.Scale = 0.9 * UpdateFitScale()
    TweenService:Create(UpdateOverlay, TweenInfo.new(0.25), { BackgroundTransparency = 0.45 }):Play()
    TweenService:Create(UpdateScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = UpdateFitScale() }):Play()
end

local checkingUpdate = false
local function CheckUpdate(manual)
    if checkingUpdate then return end
    checkingUpdate = true
    task.spawn(function()
        local data
        pcall(function()
            local src
            local ok, res = pcall(function() return game:HttpGet(UPDATE_URL) end)
            if ok and type(res) == "string" and #res > 0 then
                src = res
            elseif ORIG_REQUEST then
                local r = ORIG_REQUEST({ Url = UPDATE_URL, Method = "GET" })
                if r and type(r.Body) == "string" and (r.StatusCode or 200) < 400 then src = r.Body end
            end
            if src and #src > 0 then
                local fn = loadstring(src)
                if fn then
                    local out = fn()
                    if type(out) == "table" then data = out end
                end
                if not data then
                    local okJ, dec = pcall(function() return HttpService:JSONDecode(src) end)
                    if okJ and type(dec) == "table" then data = dec end
                end
            end
        end)
        checkingUpdate = false
        if not ScreenGui.Parent then return end
        if not data then
            if manual then ShowiOSNotification("Updates", "Could not load update info", true) end
            return
        end
        local id = tostring(data.Id or data.Version or data.Title or "update")
        if manual or id ~= customConfig.UpdateSeen then
            ShowUpdate(data)
        end
    end)
end

