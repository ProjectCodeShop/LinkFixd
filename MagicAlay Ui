        PlaySound(SOUND_CLICK)
        if favoriteScripts[titleText] then
            favoriteScripts[titleText] = nil
            ShowiOSNotification("Favorites", "Removed from Favorites")
        else
            favoriteScripts[titleText] = {
                Title = titleText,
                Desc = descText,
                PlaceId = placeId,
                CustomImage = customImage,
                FallbackIconId = fallbackIconId
            }
            ShowiOSNotification("Favorites", "Added to Favorites")
        end
        SaveFavorites()
        UpdateFavIcon()
        if RefreshFavoritesUI then RefreshFavoritesUI() end
    end)

    Card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(Card, TweenInfo.new(0.15), {BackgroundTransparency = 0.90}):Play()
