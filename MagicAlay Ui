ApplySearch = function()
    local q = string.lower(SearchBox.Text)
    local onlyCurrent = scriptFilter == "current"
    local curId = tostring(game.PlaceId)
    local visibleRec = 0
    for _, card in ipairs(RecContainer:GetChildren()) do
        if card:IsA("TextButton") then
            local t = card:FindFirstChild("GameTitle")
            local match = (q == "") or (t ~= nil and string.find(string.lower(t.Text), q, 1, true) ~= nil)
            if onlyCurrent and card:GetAttribute("PlaceId") ~= curId then match = false end
            card.Visible = match
            if match then visibleRec = visibleRec + 1 end
        end
    end
    for _, card in ipairs(FavContainer:GetChildren()) do
        if card:IsA("TextButton") then
            local t = card:FindFirstChild("GameTitle")
            card.Visible = (q == "") or (t ~= nil and string.find(string.lower(t.Text), q, 1, true) ~= nil)
        end
    end
    ScriptsUI.Reco.Visible = ScriptsUI.RecoCount > 0 and q == "" and not onlyCurrent
    ScriptsUI.Detected.Visible = (q == "")
    local E = ScriptsUI.Empty
    if scriptsState == "loading" then
        E.Text, E.Visible = "Loading scripts...", true
    elseif scriptsState == "failed" then
        E.Text, E.Visible = "Couldn't load scripts. Check your connection.", true
    else
        E.Visible = (visibleRec == 0)
        E.Text = onlyCurrent and "No script for this game yet" or "No results"
    end
    ScriptsUI.RefreshChips()
end
