local function findGlobalTarget()
    local Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return nil end
    local RootPart = Character.HumanoidRootPart
    local closest, lastDist = nil, 100 
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent ~= Character then
            local isPlayer = Players:GetPlayerFromCharacter(obj.Parent)
            local isDummy = not isPlayer

            local canTarget = (TARGET_MODE == 1) or (TARGET_MODE == 2 and isPlayer) or (TARGET_MODE == 3 and isDummy)
            if canTarget then
                local targetRoot = obj.Parent:FindFirstChild("HumanoidRootPart")
                if targetRoot then
                    local dist = (RootPart.Position - targetRoot.Position).Magnitude
                    if dist < lastDist then lastDist = dist closest = targetRoot end
                end
            end
        end
    end
    return closest
end

local ExecuteTechAction = function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local RootPart = char.HumanoidRootPart
    local target = findGlobalTarget()

    if target and target.Parent then
        task.spawn(function() 
            VirtualInput:SendKeyEvent(true, DASH_KEY, false, game)
            if MULTI_TAP_TECH then
                task.wait(0.05) VirtualInput:SendKeyEvent(false, DASH_KEY, false, game)
                task.wait(0.05) VirtualInput:SendKeyEvent(true, DASH_KEY, false, game)
            end
        end)
        
        local startTime = tick()
        local connection
        connection = RunService.Heartbeat:Connect(function()
            local elapsed = tick() - startTime
            if target and target.Parent and elapsed < LOCK_DURATION then
                local tVelocity = target.AssemblyLinearVelocity or Vector3.zero
                local predictedPos = target.Position + (tVelocity * 0.05)
                local underTargetCFrame = CFrame.new(predictedPos - Vector3.new(0, 3.2, 0), predictedPos + target.CFrame.LookVector)
                RootPart.CFrame = underTargetCFrame
                RootPart.AssemblyLinearVelocity = Vector3.new(tVelocity.X * 1.2, -15, tVelocity.Z * 1.2)
            else
                VirtualInput:SendKeyEvent(false, DASH_KEY, false, game)
                connection:Disconnect()
            end
        end)
    end
end

local ExecuteTechSixteen = function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local RootPart = char.HumanoidRootPart
    local target = findGlobalTarget()

    if target and target.Parent then
        task.wait(0.12)
        task.spawn(function() VirtualInput:SendKeyEvent(true, DASH_KEY, false, game) end)

        local startTime = tick()
        local connection
        connection = RunService.Heartbeat:Connect(function()
            local elapsed = tick() - startTime
            if target and target.Parent and elapsed < (LOCK_DURATION + 0.2) then
                local tVelocity = target.AssemblyLinearVelocity or Vector3.zero
                local fastPos = target.Position + (tVelocity * 0.08)
                local sixteenCFrame = CFrame.new(fastPos - Vector3.new(0, 3.8, 0), fastPos + target.CFrame.LookVector * 2)
                RootPart.CFrame = sixteenCFrame
                RootPart.AssemblyLinearVelocity = Vector3.new(tVelocity.X * 2, -30, tVelocity.Z * 2)
            else
                VirtualInput:SendKeyEvent(false, DASH_KEY, false, game)
                connection:Disconnect()
            end
        end)
    end
end

local function ConnectCharacter(Character)
    local Humanoid = Character:WaitForChild("Humanoid")
    local RootPart = Character:WaitForChild("HumanoidRootPart")

    Humanoid.AnimationPlayed:Connect(function(track)
        local animId = track.Animation.AnimationId
        
        if (animId:find(TARGET_ANIM_ID) or animId:find(Q_DASH_ID)) then
            local target = findGlobalTarget()
            task.wait(track.Length * 0.35)
            if target and target.Parent then
                if TECH_SIXTEEN_ENABLED then ExecuteTechSixteen()
                elseif TECH_SUB_ENABLED then ExecuteTechAction() end
            end
        
        elseif (SPIN_ANIM_IDS[animId:sub(-11)] or SPIN_ANIM_IDS[animId]) and SPIN_ENABLED then
            if tick() - LAST_SPIN < SPIN_DELAY then return end
            LAST_SPIN = tick()
            local target = findGlobalTarget()
            if target and target.Parent then
                VirtualInput:SendKeyEvent(true, Enum.KeyCode.A, false, game) 
                task.spawn(function() VirtualInput:SendKeyEvent(true, DASH_KEY, false, game) end)
                local startTime, angle = tick(), 0
                local connection
                connection = RunService.Heartbeat:Connect(function()
                    if target and target.Parent and (tick() - startTime) < LOCK_DURATION then
                        angle = angle + (0.2 * SPIN_SPEED)
                        local closeRadius = 2.8
                        local offset = Vector3.new(math.cos(angle) * closeRadius, 0.5, math.sin(angle) * closeRadius)
                        RootPart.CFrame = CFrame.new(target.Position + offset, target.Position)
                        RootPart.AssemblyLinearVelocity = (target.Position - RootPart.Position).Unit * (30 * SPIN_SPEED)
                    else
                        VirtualInput:SendKeyEvent(false, DASH_KEY, false, game)
                        VirtualInput:SendKeyEvent(false, Enum.KeyCode.A, false, game)
                        connection:Disconnect()
                    end
                end)
            end
        end
    end)
end

