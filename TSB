    DropBtn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", DropBtn).CornerRadius = UDim.new(0, 3)
    
    local ListFrame = Instance.new("Frame")
    ListFrame.Parent = DropdownOverlayFrame
    ListFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    ListFrame.Size = UDim2.new(0, box.Size.X.Offset - 16, 0, #options * 20 + 4)
    ListFrame.Visible = false
    Instance.new("UICorner", ListFrame).CornerRadius = UDim.new(0, 3)
    
    local UIList = Instance.new("UIListLayout")
    UIList.Parent = ListFrame
    UIList.SortOrder = Enum.SortOrder.LayoutOrder
    UIList.Padding = UDim.new(0, 2)
    
    for i, opt in ipairs(options) do
        local OptBtn = Instance.new("TextButton")
        OptBtn.Parent = ListFrame
        OptBtn.BackgroundTransparency = 1
        OptBtn.Size = UDim2.new(1, 0, 0, 18)
        OptBtn.Font = Enum.Font.Gotham
        OptBtn.Text = "  " .. opt
        OptBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
