local function ToggleUI()
    if isAnimating then return end
    isAnimating = true
    closeActiveDropdown()
    
    uiVisible = not uiVisible

    if uiVisible then
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 470, 0, 280)
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 520, 0, 310)
        })
        tween:Play()
        tween.Completed:Connect(function() isAnimating = false end)
    else
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 470, 0, 280)
        })
        tween:Play()
        tween.Completed:Connect(function()
            if not uiVisible then MainFrame.Visible = false end
            isAnimating = false
        end)
    end
end

